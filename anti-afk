local function startEngine()
    local dragStartPos, currentPos
    local targetPos = nil
    local lastClickTime = 0

    UI.root.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            State.lastUserInput = os.clock()
            local timeNow = os.clock()
            
            if timeNow - lastClickTime < 0.3 then
                State.isCollapsed = not State.isCollapsed
                if State.isCollapsed then
                    TweenService:Create(UI.root, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(48, 48) }):Play()
                else
                    TweenService:Create(UI.root, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(Q.sizeW, Q.sizeH) }):Play()
                end
                return
            end
            lastClickTime = timeNow

            State.isDragging = true
            dragStartPos = input.Position
            currentPos = Vector2.new(UI.root.AbsolutePosition.X, UI.root.AbsolutePosition.Y)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not State.isDragging then return end
        State.lastUserInput = os.clock()
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStartPos
            local vp = workspace.CurrentCamera.ViewportSize
            local s = UI.root.AbsoluteSize
            
            local nx = math.clamp(currentPos.X + delta.X, 0, vp.X - s.X)
            local ny = math.clamp(currentPos.Y + delta.Y, 0, vp.Y - s.Y)
            targetPos = Vector2.new(nx, ny)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if State.isDragging then
                State.isDragging = false
                targetPos = nil
                if getgenv then
                    getgenv().AAFX_STATE = getgenv().AAFX_STATE or {}
                    getgenv().AAFX_STATE.pos = { X = UI.root.Position.X.Offset, Y = UI.root.Position.Y.Offset }
                end
            end
        end
    end)

    task.spawn(function()
        while State.alive do
            if State.running and os.clock() >= State.nextAction then runCycle() end
            task.wait(1)
        end
    end)

    RunService.Heartbeat:Connect(function(dt)
        if not UI.root or not UI.root.Parent then return end
        
        if State.isDragging and targetPos then
            local cur = UI.root.Position
            local cx = cur.X.Offset + (targetPos.X - cur.X.Offset) * math.clamp(dt * 20, 0, 1)
            local cy = cur.Y.Offset + (targetPos.Y - cur.Y.Offset) * math.clamp(dt * 20, 0, 1)
            UI.root.Position = UDim2.new(0, cx, 0, cy)
        end

        local t = os.clock()
        local pulse = (math.sin(t * 2) + 1) / 2
        
        if UI.dotScale then
            UI.dotScale.Scale = 1 + (pulse * 0.2)
            UI.glow.BackgroundTransparency = 0.8 - (pulse * 0.4)
            UI.dot.BackgroundColor3 = State.status == "error" and C.err or State.status == "paused" and C.warn or C.ok
        end

        if UI.shimmer then
            local shimX = (t % 4) / 4
            UI.shimmer.Position = UDim2.new(shimX * 2 - 0.5, 0, 0, 0)
        end

        if UI.stroke and UI.stroke:FindFirstChildOfClass("UIGradient") then
            UI.stroke.UIGradient.Rotation = (t * 30) % 360
        end

        if UI.timeLbl then
            local tm = math.floor(t - State.startTime)
            UI.timeLbl.Text = string.format("%02d:%02d:%02d", math.floor(tm/3600), math.floor((tm%3600)/60), math.floor(tm%60))
        end

        if UI.bg and not State.isCollapsed then
            local targetH = State.isHovering and Q.sizeHExpanded or Q.sizeH
            if math.abs(UI.root.Size.Y.Offset - targetH) > 1 then
                local currentH = UI.root.Size.Y.Offset
                UI.root.Size = UDim2.new(0, Q.sizeW, 0, currentH + (targetH - currentH) * math.clamp(dt * 15, 0, 1))
            end
            if UI.statsFrame then
                UI.statsFrame.Visible = State.isHovering
                if State.isHovering then
                    UI.statsAct.Text = LCL.act..": "..State.actions
                    UI.statsErr.Text = LCL.err..": "..State.errors
                end
            end
        end
    end)
end

