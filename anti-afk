local State = {
    running = true, alive = true, startTime = os.clock(),
    nextAction = os.clock() + Q.interval, lastUserInput = 0,
    actions = 0, errors = 0, consecErrs = 0, status = "active",
    methodIdx = 1, isCollapsed = false, isDragging = false, isHovering = false
}

local function isAlive()
    local char = LP and LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function M_CAM()
    if os.clock() - State.lastUserInput < Q.userActiveWin then return true end
    local cam = workspace.CurrentCamera
    if not cam then return false end
    pcall(function()
        local orig = cam.CFrame
        local amt = math.rad(Q.cameraShake)
        cam.CFrame = orig * CFrame.Angles(0, amt, 0) task.wait(0.1)
        cam.CFrame = orig * CFrame.Angles(0, -amt, 0) task.wait(0.1)
        cam.CFrame = orig
    end)
    return true
end

local function M_VU()
    if not Q.useVirtualUser or not VirtualUser then return false end
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:SetKeyDown("shift") task.wait(0.05) VirtualUser:SetKeyUp("shift")
    end)
    return true
end

local function M_WALK()
    if not isAlive() then return false end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    pcall(function()
        hum:Move(Vector3.new(0, 0, 0.01), false) task.wait(0.1) hum:Move(Vector3.new(0, 0, 0), false)
    end)
    return true
end

local function runCycle()
    State.nextAction = os.clock() + Q.interval
    if not Q.enabled or not isAlive() then return end
    local m = METHODS[State.methodIdx]
    local methodsToRun = (m == "all") and {M_CAM, M_VU, M_WALK} or (m == "camera") and {M_CAM} or (m == "virtualuser") and {M_VU, M_CAM} or {M_WALK}
    local success = false
    for _, fn in ipairs(methodsToRun) do if fn() then success = true break end end
    if success then State.actions = State.actions + 1 State.consecErrs = 0 State.status = "active"
    else State.errors = State.errors + 1 State.consecErrs = State.consecErrs + 1 if State.consecErrs >= 3 then State.status = "error" end end
end

