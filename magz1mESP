local function safe(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok and Config.Debug then warn("[magz1mESP] " .. tostring(err)) end
    return ok
end

local function clamp(x,a,b) return math.max(a, math.min(b, x)) end

local function colorToHex(c)
    return string.format("#%02X%02X%02X",
        math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
end

local function hexToColor(hex)
    hex = (hex or ""):gsub("#","")
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1,2),16)
    local g = tonumber(hex:sub(3,4),16)
    local b = tonumber(hex:sub(5,6),16)
    if not (r and g and b) then return nil end
    return Color3.fromRGB(r,g,b)
end

local function getColorAt(t)
    if Config.ColorMode == "Rainbow" then
        return Color3.new(
            math.sin(t) * 0.5 + 0.5,
            math.sin(t + 2.094) * 0.5 + 0.5,
            math.sin(t + 4.188) * 0.5 + 0.5)
    elseif Config.ColorMode == "Pastel" then
        return Color3.new(
            math.sin(t) * 0.2 + 0.8,
            math.sin(t + 2.094) * 0.2 + 0.8,
            math.sin(t + 4.188) * 0.2 + 0.8)
    end
    return Config.StaticColor
end

local function getCurrentColor()
    if Config.ColorMode ~= "Static" then
        return getColorAt(tick() * Config.RainbowSpeed)
    end
    return Config.StaticColor
end

