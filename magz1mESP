local function isWhitelisted(player)
    if Whitelist[player.UserId] then return true end
    if Config.WhitelistFriends and LocalPlayer:IsFriendsWith(player.UserId) then return true end
    return false
end

local function shouldRender(player)
    if player == LocalPlayer then return false end
    if Blacklist[player.UserId] then return false end
    if Config.TeamCheck and player.Team == LocalPlayer.Team then return false end
    if isWhitelisted(player) and Config.WhitelistFriends then return false end
    return true
end

local function getHumanoidParts(char)
    local h = char:FindFirstChildOfClass("Humanoid")
    if not h then return nil end
    if h.RigType == Enum.HumanoidRigType.R15 then
        return {
            Head=char:FindFirstChild("Head"), UpperTorso=char:FindFirstChild("UpperTorso"), LowerTorso=char:FindFirstChild("LowerTorso"),
            LeftUpperArm=char:FindFirstChild("LeftUpperArm"), LeftLowerArm=char:FindFirstChild("LeftLowerArm"), LeftHand=char:FindFirstChild("LeftHand"),
            RightUpperArm=char:FindFirstChild("RightUpperArm"), RightLowerArm=char:FindFirstChild("RightLowerArm"), RightHand=char:FindFirstChild("RightHand"),
            LeftUpperLeg=char:FindFirstChild("LeftUpperLeg"), LeftLowerLeg=char:FindFirstChild("LeftLowerLeg"), LeftFoot=char:FindFirstChild("LeftFoot"),
            RightUpperLeg=char:FindFirstChild("RightUpperLeg"), RightLowerLeg=char:FindFirstChild("RightLowerLeg"), RightFoot=char:FindFirstChild("RightFoot"),
            HumanoidRootPart=char:FindFirstChild("HumanoidRootPart"),
        }, "R15"
    else
        return {
            Head=char:FindFirstChild("Head"), Torso=char:FindFirstChild("Torso"),
            LeftArm=char:FindFirstChild("Left Arm"), RightArm=char:FindFirstChild("Right Arm"),
            LeftLeg=char:FindFirstChild("Left Leg"), RightLeg=char:FindFirstChild("Right Leg"),
            HumanoidRootPart=char:FindFirstChild("HumanoidRootPart"),
        }, "R6"
    end
end

local function project(v3)
    local p, onScreen = Camera:WorldToViewportPoint(v3)
    if not onScreen then return nil end
    return Vector2.new(p.X, p.Y)
end

local function updateChams(player, obj, enabled)
    if not player.Character then return end
    if enabled and not obj.chams then
        local hl = Instance.new("Highlight")
        hl.Adornee = player.Character; hl.FillColor = getCurrentColor(); hl.OutlineColor = getCurrentColor()
        hl.FillTransparency = Config.ShowChamsGradient and 0.7 or 0.6; hl.OutlineTransparency = 0.2
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent = GUI; obj.chams = hl
    elseif not enabled and obj.chams then
        obj.chams:Destroy(); obj.chams = nil
    elseif obj.chams then
        obj.chams.FillColor = getCurrentColor(); obj.chams.OutlineColor = getCurrentColor()
    end
end

local function updateESP(player, obj, dt)
    if not Config.ESPEnabled or not shouldRender(player) then
        for _, l in ipairs(obj.boneLines) do l.Visible = false end
        for _, l in ipairs(obj.boxLines) do l.Visible = false end
        for _, l in ipairs(obj.edges3D) do l.Visible = false end
        for _, l in ipairs(obj.cornerSegs) do l.Visible = false end
        for _, l in ipairs(obj.glowLines) do l.Visible = false end
        for _, l in ipairs(obj.trailLines) do l.Visible = false end
        for _, c in ipairs(obj.jointCircles) do c.Visible = false end
        for _, t in ipairs({obj.nameText, obj.displayNameText, obj.distanceText, obj.itemText, obj.statusText}) do t.Visible = false end
        obj.filledBox.Visible = false; obj.tracer.Visible = false; obj.weaponTracer.Visible = false
        obj.offscreenArrow.Visible = false; obj.feetCircle.Visible = false; obj.halo.Visible = false
        obj.healthBg.Visible = false; obj.healthFill.Visible = false
        if obj.chams then obj.chams:Destroy(); obj.chams = nil end
        return
    end

    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso")
    if not root then return end

    local dist = (root.Position - Camera.CFrame.Position).Magnitude
    if dist > Config.MaxDistance then return end

    local color = getCurrentColor()
    local transp = Config.ESPTransparency
    local thick = Config.LineThickness

    if Config.FadeAnimations then
        obj.alpha = obj.alpha + (obj.targetAlpha - obj.alpha) * math.min(dt * 8, 1)
    else
        obj.alpha = 1
    end

    updateChams(player, obj, Config.ShowChams or Config.ShowChamsGradient)

    local parts, rig = getHumanoidParts(char)
    if not parts then return end

    local head, torso, lowerTorso
    if rig == "R15" then
        head = parts.Head; torso = parts.UpperTorso; lowerTorso = parts.LowerTorso
    else
        head = parts.Head; torso = parts.Torso; lowerTorso = parts.Torso
    end
    if not head or not torso or not lowerTorso then return end

    local screenHead = project(head.Position + Vector3.new(0, 0.7, 0))
    local screenTorso = project(torso.Position)
    local screenFeet = project(lowerTorso.Position - Vector3.new(0, 2.2, 0))

    if not screenHead or not screenTorso or not screenFeet then
        if Config.ShowOffscreenArrow then
            local screenPos, onScreen = Camera:WorldToViewportPoint(torso.Position)
            if not onScreen then
                local vp = Camera.ViewportSize
                local center = vp / 2
                local dx = screenPos.X - center.X
                local dy = screenPos.Y - center.Y
                local len = math.sqrt(dx*dx + dy*dy)
                if len > 0 then
                    local nx, ny = dx/len, dy/len
                    local radius = math.min(vp.X, vp.Y) / 2 - 40
                    local ax = center.X + nx * radius
                    local ay = center.Y + ny * radius
                    obj.offscreenArrow.Visible = true
                    obj.offscreenArrow.Color = color; obj.offscreenArrow.Transparency = transp
                    obj.offscreenArrow.PointA = Vector2.new(ax + nx*12, ay + ny*12)
                    obj.offscreenArrow.PointB = Vector2.new(ax - ny*8, ay + nx*8)
                    obj.offscreenArrow.PointC = Vector2.new(ax + ny*8, ay - nx*8)
                end
            end
        end
        return
    end
    obj.offscreenArrow.Visible = false

    local boxTop = screenHead.Y - 8
    local boxBottom = screenFeet.Y
    local boxH = boxBottom - boxTop
    local boxW = boxH * 0.55
    local boxLeft = screenTorso.X - boxW/2
    local boxRight = screenTorso.X + boxW/2
    local boxCenterX = screenTorso.X

    local finalTrans = transp * obj.alpha
    if Config.Pulsation then finalTrans = finalTrans * (0.7 + math.sin(tick()*4) * 0.3) end

    if Config.ShowBox then
        local tl = Vector2.new(boxLeft, boxTop); local tr = Vector2.new(boxRight, boxTop)
        local bl = Vector2.new(boxLeft, boxBottom); local br = Vector2.new(boxRight, boxBottom)
        local pairs4 = {{tl,tr},{tr,br},{br,bl},{bl,tl}}
        for i, p in ipairs(pairs4) do
            local l = obj.boxLines[i]
            l.From = p[1]; l.To = p[2]; l.Color = color; l.Thickness = thick; l.Transparency = finalTrans; l.Visible = true
        end
    else
        for _, l in ipairs(obj.boxLines) do l.Visible = false end
    end

    if Config.ShowFilledBox then
        obj.filledBox.Size = Vector2.new(boxW, boxH); obj.filledBox.Position = Vector2.new(boxLeft, boxTop)
        obj.filledBox.Color = color; obj.filledBox.Transparency = 0.75 * obj.alpha; obj.filledBox.Visible = true
    else
        obj.filledBox.Visible = false
    end

    if Config.ShowCornerBox then
        local cl = boxW * 0.25; local ch = boxH * 0.2
        local c = {
            {Vector2.new(boxLeft, boxTop), Vector2.new(boxLeft+cl, boxTop)},
            {Vector2.new(boxLeft, boxTop), Vector2.new(boxLeft, boxTop+ch)},
            {Vector2.new(boxRight, boxTop), Vector2.new(boxRight-cl, boxTop)},
            {Vector2.new(boxRight, boxTop), Vector2.new(boxRight, boxTop+ch)},
            {Vector2.new(boxLeft, boxBottom), Vector2.new(boxLeft+cl, boxBottom)},
            {Vector2.new(boxLeft, boxBottom), Vector2.new(boxLeft, boxBottom-ch)},
            {Vector2.new(boxRight, boxBottom), Vector2.new(boxRight-cl, boxBottom)},
            {Vector2.new(boxRight, boxBottom), Vector2.new(boxRight, boxBottom-ch)},
        }
        for i, seg in ipairs(c) do
            local l = obj.cornerSegs[i]
            l.From = seg[1]; l.To = seg[2]; l.Color = color; l.Thickness = thick * 1.8; l.Transparency = finalTrans; l.Visible = true
        end
    else
        for _, l in ipairs(obj.cornerSegs) do l.Visible = false end
    end

    if Config.Show3DBox then
        local cf = torso.CFrame; local sz = Vector3.new(2, 5, 1); local corners = {}
        for i=-1,1,2 do for j=-1,1,2 do for k=-1,1,2 do
            corners[#corners+1] = cf * Vector3.new(i*sz.X/2, j*sz.Y/2, k*sz.Z/2)
        end end end
        local edges = {{1,2},{1,3},{1,5},{2,4},{2,6},{3,4},{3,7},{4,8},{5,6},{5,7},{6,8},{7,8}}
        for i, e in ipairs(edges) do
            local a = project(corners[e[1]]); local b = project(corners[e[2]])
            local l = obj.edges3D[i]
            if a and b then
                l.From = a; l.To = b; l.Color = color; l.Thickness = thick; l.Transparency = finalTrans; l.Visible = true
            else l.Visible = false end
        end
    else
        for _, l in ipairs(obj.edges3D) do l.Visible = false end
    end

    local showSkel = Config.ShowSkeleton and dist < Config.SkeletonDistance
    if showSkel then
        local bonePairs
        if rig == "R15" then
            bonePairs = {
                {parts.Head, parts.UpperTorso}, {parts.UpperTorso, parts.LowerTorso},
                {parts.UpperTorso, parts.LeftUpperArm}, {parts.LeftUpperArm, parts.LeftLowerArm}, {parts.LeftLowerArm, parts.LeftHand},
                {parts.UpperTorso, parts.RightUpperArm}, {parts.RightUpperArm, parts.RightLowerArm}, {parts.RightLowerArm, parts.RightHand},
                {parts.LowerTorso, parts.LeftUpperLeg}, {parts.LeftUpperLeg, parts.LeftLowerLeg}, {parts.LeftLowerLeg, parts.LeftFoot},
                {parts.LowerTorso, parts.RightUpperLeg}, {parts.RightUpperLeg, parts.RightLowerLeg}, {parts.RightLowerLeg, parts.RightFoot},
            }
        else
            bonePairs = {
                {parts.Head, parts.Torso}, {parts.Torso, parts.LeftArm}, {parts.Torso, parts.RightArm},
                {parts.Torso, parts.LeftLeg}, {parts.Torso, parts.RightLeg},
            }
        end

        for i, pair in ipairs(bonePairs) do
            local from = pair[1]; local to = pair[2]
            if from and to then
                local a = project(from.Position); local b = project(to.Position)
                if a and b then
                    local l = obj.boneLines[i]
                    l.From = a; l.To = b; l.Color = color; l.Thickness = thick; l.Transparency = finalTrans; l.Visible = true
                    if Config.ShowGlow then
                        local g = obj.glowLines[i]
                        g.From = a; g.To = b; g.Color = color; g.Thickness = thick * 3; g.Transparency = finalTrans * 0.6; g.Visible = true
                    else obj.glowLines[i].Visible = false end
                    if Config.ShowJoints then
                        local c = obj.jointCircles[i]
                        c.Position = a; c.Color = color; c.Transparency = finalTrans; c.Radius = 3; c.Visible = true
                    else obj.jointCircles[i].Visible = false end
                else
                    obj.boneLines[i].Visible = false; obj.glowLines[i].Visible = false
                    if obj.jointCircles[i] then obj.jointCircles[i].Visible = false end
                end
            end
        end
        for i=#bonePairs+1, #obj.boneLines do
            obj.boneLines[i].Visible = false; obj.glowLines[i].Visible = false
            if obj.jointCircles[i] then obj.jointCircles[i].Visible = false end
        end
    else
        for _, l in ipairs(obj.boneLines) do l.Visible = false end
        for _, l in ipairs(obj.glowLines) do l.Visible = false end
        for _, c in ipairs(obj.jointCircles) do c.Visible = false end
    end

    if Config.ShowTracer then
        obj.tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
        obj.tracer.To = Vector2.new(boxCenterX, boxBottom)
        obj.tracer.Color = color; obj.tracer.Thickness = thick; obj.tracer.Transparency = finalTrans; obj.tracer.Visible = true
    else obj.tracer.Visible = false end

    if Config.ShowWeaponTracer then
        local myChar = LocalPlayer.Character
        local myHand = myChar and (myChar:FindFirstChild("RightHand") or myChar:FindFirstChild("Right Arm"))
        if myHand then
            local a = project(myHand.Position)
            if a then
                obj.weaponTracer.From = a; obj.weaponTracer.To = Vector2.new(boxCenterX, boxTop + boxH/2)
                obj.weaponTracer.Color = color; obj.weaponTracer.Thickness = thick * 0.8; obj.weaponTracer.Transparency = finalTrans * 0.7; obj.weaponTracer.Visible = true
            else obj.weaponTracer.Visible = false end
        else obj.weaponTracer.Visible = false end
    else obj.weaponTracer.Visible = false end

    if Config.ShowFeetCircle then
        local fp = project(lowerTorso.Position - Vector3.new(0, 2.5, 0))
        if fp then
            obj.feetCircle.Position = fp; obj.feetCircle.Radius = math.max(14, boxH * 0.2)
            obj.feetCircle.Color = color; obj.feetCircle.Transparency = finalTrans * 0.8; obj.feetCircle.Thickness = thick; obj.feetCircle.Visible = true
        end
    else obj.feetCircle.Visible = false end

    if Config.ShowHalo then
        local hp = project(head.Position + Vector3.new(0, 1, 0))
        if hp then
            obj.halo.Position = hp; obj.halo.Radius = 12 + math.sin(tick()*3) * 2
            obj.halo.Color = color; obj.halo.Transparency = finalTrans * 0.8; obj.halo.Thickness = thick; obj.halo.Visible = true
        end
    else obj.halo.Visible = false end

    if Config.ShowTrail then
        local pos = root.Position
        if not obj.lastPos or (pos - obj.lastPos).Magnitude > 2 then
            table.insert(obj.trailPositions, pos)
            if #obj.trailPositions > 8 then table.remove(obj.trailPositions, 1) end
            obj.lastPos = pos
        end
        for i=1, #obj.trailPositions-1 do
            local a = project(obj.trailPositions[i]); local b = project(obj.trailPositions[i+1])
            local line = obj.trailLines[i]
            if line and a and b then
                line.From = a; line.To = b; line.Color = color
                line.Thickness = thick * (i / #obj.trailPositions)
                line.Transparency = finalTrans * (i / #obj.trailPositions) * 0.7; line.Visible = true
            elseif line then line.Visible = false end
        end
        for i=#obj.trailPositions, #obj.trailLines do obj.trailLines[i].Visible = false end
    else
        for _, l in ipairs(obj.trailLines) do l.Visible = false end
        obj.trailPositions = {}
    end

    local yBase = boxTop - 4
    local ts = Config.TextSize

    if Config.ShowName and screenHead then
        obj.nameText.Text = player.Name; obj.nameText.Position = Vector2.new(boxCenterX, yBase - ts)
        obj.nameText.Color = color; obj.nameText.Size = ts; obj.nameText.Transparency = finalTrans; obj.nameText.Visible = true
        yBase = yBase - ts
    else obj.nameText.Visible = false end

    if Config.ShowDisplayName and screenHead then
        obj.displayNameText.Text = "(" .. player.DisplayName .. ")"
        obj.displayNameText.Position = Vector2.new(boxCenterX, yBase - ts + 2)
        obj.displayNameText.Color = color; obj.displayNameText.Size = ts - 2; obj.displayNameText.Transparency = finalTrans * 0.9; obj.displayNameText.Visible = true
        yBase = yBase - ts + 2
    else obj.displayNameText.Visible = false end

    if Config.ShowDistance and screenHead then
        obj.distanceText.Text = "[" .. math.floor(dist) .. "m]"
        obj.distanceText.Position = Vector2.new(boxCenterX, yBase - ts + 2)
        obj.distanceText.Color = color; obj.distanceText.Size = ts - 2; obj.distanceText.Transparency = finalTrans * 0.9; obj.distanceText.Visible = true
    else obj.distanceText.Visible = false end

    if Config.ShowItem and screenHead then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            obj.itemText.Text = "[" .. tool.Name .. "]"; obj.itemText.Position = Vector2.new(boxCenterX, boxBottom + 6)
            obj.itemText.Color = color; obj.itemText.Size = ts - 2; obj.itemText.Transparency = finalTrans; obj.itemText.Visible = true
        else obj.itemText.Visible = false end
    else obj.itemText.Visible = false end

    if Config.ShowStatusIcon then
        local st = ""
        if humanoid.Health < humanoid.MaxHealth * 0.3 then st = "!" end
        if st ~= "" and screenHead then
            obj.statusText.Text = st; obj.statusText.Position = Vector2.new(boxLeft - 14, boxTop + boxH/2)
            obj.statusText.Color = color; obj.statusText.Size = ts + 4; obj.statusText.Transparency = finalTrans; obj.statusText.Visible = true
        else obj.statusText.Visible = false end
    else obj.statusText.Visible = false end

    if Config.ShowHealthBar then
        local hx = boxLeft - 6; local hh = boxH; local hTop = boxTop; local hBot = boxBottom
        local hpct = humanoid.Health / humanoid.MaxHealth; local fillTop = hBot - hh * hpct
        obj.healthBg.From = Vector2.new(hx, hTop); obj.healthBg.To = Vector2.new(hx, hBot)
        obj.healthBg.Color = Color3.fromRGB(30, 20, 50); obj.healthBg.Thickness = 4; obj.healthBg.Transparency = finalTrans * 0.6; obj.healthBg.Visible = true
        obj.healthFill.From = Vector2.new(hx, fillTop); obj.healthFill.To = Vector2.new(hx, hBot)
        obj.healthFill.Color = Color3.fromRGB(255*(1-hpct), 255*hpct, 50); obj.healthFill.Thickness = 4; obj.healthFill.Transparency = finalTrans; obj.healthFill.Visible = true
    else
        obj.healthBg.Visible = false; obj.healthFill.Visible = false
    end

    MinimapData[player] = {pos = root.Position, name = player.Name, color = color}
end

-- ============================================================
-- MINIMAP
-- ============================================================
local MinimapFrame, RadarFrame
local function setupMinimap()
    if MinimapFrame then return end
    local T = getT()
    MinimapFrame = Instance.new("Frame")
    MinimapFrame.Size = UDim2.new(0, 140, 0, 140)
    MinimapFrame.Position = UDim2.new(1, -160, 1, -160)
    MinimapFrame.BackgroundColor3 = T.bg1; MinimapFrame.BackgroundTransparency = 0.25
    MinimapFrame.BorderSizePixel = 0; MinimapFrame.Visible = false; MinimapFrame.Parent = GUI
    corner(MinimapFrame, 70); stroke(MinimapFrame, T.stroke, 1.5, 0.4)
    local lbl = textLabel(MinimapFrame, "N", 12, T.accent, true)
    lbl.Size = UDim2.new(1, 0, 0, 16); lbl.Position = UDim2.new(0, 0, 0, 4); lbl.TextXAlignment = Enum.TextXAlignment.Center
end

local function updateMinimap()
    if not MinimapFrame then return end
    MinimapFrame.Visible = Config.ShowMinimap
    if not Config.ShowMinimap then return end

    for _, c in ipairs(MinimapFrame:GetChildren()) do
        if c:IsA("Frame") and c.Name == "Dot" then c:Destroy() end
    end

    local center = Vector2.new(70, 70); local range = 500
    for p, data in pairs(MinimapData) do
        local rel = data.pos - Camera.CFrame.Position
        local angle = math.atan2(rel.X, rel.Z) - math.atan2(Camera.CFrame.LookVector.X, Camera.CFrame.LookVector.Z)
        local dist = math.sqrt(rel.X^2 + rel.Z^2)
        if dist < range then
            local r = dist / range * 60
            local x = center.X + math.sin(angle) * r
            local y = center.Y - math.cos(angle) * r
            local dot = Instance.new("Frame")
            dot.Name = "Dot"; dot.Size = UDim2.new(0, 6, 0, 6); dot.Position = UDim2.new(0, x-3, 0, y-3)
            dot.BackgroundColor3 = data.color; dot.BorderSizePixel = 0; dot.Parent = MinimapFrame; corner(dot, 3)
        end
    end
    local selfDot = Instance.new("Frame")
    selfDot.Name = "Dot"; selfDot.Size = UDim2.new(0, 8, 0, 8); selfDot.Position = UDim2.new(0, 66, 0, 66)
    selfDot.BackgroundColor3 = Color3.new(1,1,1); selfDot.BorderSizePixel = 0; selfDot.Parent = MinimapFrame; corner(selfDot, 4)
end

local function setupRadar()
    if RadarFrame then return end
    local T = getT()
    RadarFrame = Instance.new("Frame")
    RadarFrame.Size = UDim2.new(0, 120, 0, 120); RadarFrame.Position = UDim2.new(0, 20, 1, -140)
    RadarFrame.BackgroundColor3 = T.bg1; RadarFrame.BackgroundTransparency = 0.4; RadarFrame.BorderSizePixel = 0
    RadarFrame.Visible = false; RadarFrame.Parent = GUI; corner(RadarFrame, 60); stroke(RadarFrame, T.stroke, 1.5, 0.4)
end

local function updateRadar()
    if not RadarFrame then return end
    RadarFrame.Visible = Config.ShowRadar
end

-- ============================================================
-- MAIN LOOP & INIT
-- ============================================================
local mainConnection
local function mainLoop()
    if not Config.ESPEnabled then return end
    FrameCounter = FrameCounter + 1
    if FrameCounter % math.max(1, Config.FrameSkip) ~= 0 then return end
    for player, obj in pairs(ESPObjects) do
        if player.Parent then safe(updateESP, player, obj, 1/60 * Config.FrameSkip)
        else ESPObjects[player] = nil end
    end
    safe(updateMinimap); safe(updateRadar)
end

local function onPlayerAdded(player)
    if player == LocalPlayer then return end
    if not ESPObjects[player] then ESPObjects[player] = createPlayerESP() end
end

local function onPlayerRemoving(player)
    local obj = ESPObjects[player]
    if obj then
        for _, l in ipairs(obj.boneLines) do l:Remove() end
        for _, c in ipairs(obj.jointCircles) do c:Remove() end
        for _, l in ipairs(obj.glowLines) do l:Remove() end
        for _, l in ipairs(obj.boxLines) do l:Remove() end
        for _, l in ipairs(obj.edges3D) do l:Remove() end
        for _, l in ipairs(obj.cornerSegs) do l:Remove() end
        for _, l in ipairs(obj.trailLines) do l:Remove() end
        obj.filledBox:Remove(); obj.tracer:Remove(); obj.weaponTracer:Remove(); obj.offscreenArrow:Remove()
        obj.feetCircle:Remove(); obj.halo:Remove(); obj.nameText:Remove(); obj.displayNameText:Remove()
        obj.distanceText:Remove(); obj.itemText:Remove(); obj.statusText:Remove(); obj.healthBg:Remove(); obj.healthFill:Remove()
        if obj.chams then obj.chams:Destroy() end
        ESPObjects[player] = nil
    end
end

function destroyAll()
    for player, obj in pairs(ESPObjects) do onPlayerRemoving(player) end
    ESPObjects = {}
    if GUI then GUI:Destroy(); GUI = nil end
    if mainConnection then mainConnection:Disconnect() end
end

local function init()
    buildGUI(); setupMinimap(); setupRadar()
    for _, p in pairs(Players:GetPlayers()) do onPlayerAdded(p) end
    Players.PlayerAdded:Connect(onPlayerAdded)
    Players.PlayerRemoving:Connect(onPlayerRemoving)
    mainConnection = RunService.RenderStepped:Connect(function(dt) safe(mainLoop, dt) end)
end

init()
