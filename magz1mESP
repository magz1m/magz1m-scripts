local function createToggle(parent, labelTxt, key, iconGlyph)
    local T = getT()
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = T.bg2
    btn.BackgroundTransparency = 0.35
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = parent
    corner(btn, 8)
    local st = stroke(btn, T.stroke, 1, 0.75)

    local ic = iconLabel(btn, iconGlyph or Icons.Diamond, 14, T.subtext)
    ic.Size = UDim2.new(0, 14, 0, 14)
    ic.Position = UDim2.new(0, 10, 0.5, -7)

    local lb = textLabel(btn, labelTxt, 13, T.text)
    lb.Size = UDim2.new(1, -80, 1, 0)
    lb.Position = UDim2.new(0, 32, 0, 0)

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 36, 0, 20)
    track.Position = UDim2.new(1, -46, 0.5, -10)
    track.BackgroundColor3 = Color3.fromRGB(50,40,70)
    track.BorderSizePixel = 0
    track.Parent = btn
    corner(track, 20)

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 16, 0, 16)
    thumb.Position = UDim2.new(0, 2, 0.5, -8)
    thumb.BackgroundColor3 = Color3.fromRGB(120,120,140)
    thumb.BorderSizePixel = 0
    thumb.Parent = track
    corner(thumb, 16)

    local state = Config[key]

    local function update(anim)
        local targetColor = state and T.accent or Color3.fromRGB(50,40,70)
        local targetThumb = state and Color3.fromRGB(255,255,255) or Color3.fromRGB(120,120,140)
        local targetPos = state and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8)
        if anim then
            TweenService:Create(track, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {BackgroundColor3=targetColor}):Play()
            TweenService:Create(thumb, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {Position=targetPos, BackgroundColor3=targetThumb}):Play()
            TweenService:Create(ic, TweenInfo.new(0.2), {ImageColor3 = state and T.accent or T.subtext}):Play()
        else
            track.BackgroundColor3 = targetColor
            thumb.Position = targetPos
            thumb.BackgroundColor3 = targetThumb
            ic.ImageColor3 = state and T.accent or T.subtext
        end
    end

    btn.MouseButton1Click:Connect(function()
        state = not state
        Config[key] = state
        update(true)
    end)

    update(false)
    return btn
end

local function createSlider(parent, labelTxt, key, minV, maxV, isFloat)
    local T = getT()
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 44)
    frame.BackgroundColor3 = T.bg2
    frame.BackgroundTransparency = 0.35
    frame.BorderSizePixel = 0
    frame.Parent = parent
    corner(frame, 8)
    stroke(frame, T.stroke, 1, 0.75)

    local lb = textLabel(frame, labelTxt, 12, T.text)
    lb.Size = UDim2.new(1, -70, 0, 16)
    lb.Position = UDim2.new(0, 10, 0, 4)

    local val = textLabel(frame, "", 12, T.accent, true)
    val.Size = UDim2.new(0, 60, 0, 16)
    val.Position = UDim2.new(1, -66, 0, 4)
    val.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -20, 0, 4)
    track.Position = UDim2.new(0, 10, 1, -14)
    track.BackgroundColor3 = Color3.fromRGB(40,30,60)
    track.BorderSizePixel = 0
    track.Parent = frame
    corner(track, 4)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = T.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 4)

    local dragging = false

    local function refresh()
        local pct = clamp((Config[key] - minV) / (maxV - minV), 0, 1)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        val.Text = isFloat and string.format("%.2f", Config[key]) or tostring(math.floor(Config[key]))
    end

    local function setFromX(mx)
        local ap = track.AbsolutePosition.X
        local asz = track.AbsoluteSize.X
        local pct = clamp((mx - ap) / asz, 0, 1)
        local v = minV + (maxV - minV) * pct
        Config[key] = isFloat and math.floor(v*100)/100 or math.floor(v + 0.5)
        refresh()
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    refresh()
    return frame
end

